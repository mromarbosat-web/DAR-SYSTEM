# Discord Bot Token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Supabase PostgreSQL Connection String
# Example for Supabase direct connection or transaction pooler:
# postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.example.supabase.co:5432/postgres

# Optional Configuration
LOG_LEVEL=INFO
ENVIRONMENT=production
BOT_PREFIX=!
DEFAULT_EMBED_COLOR=0x5865F2

# Bot Owner & Global Economy Configuration
BOT_OWNER_IDS=1406547827865288786,1377224857292636200
MAIN_GUILD_ID=1391459645528215582
CURRENCY_NAME=سراب
CURRENCY_EMOJI=🌫️
